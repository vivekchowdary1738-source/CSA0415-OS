
#include <stdio.h>

int main()
{
    int b[20], p[20], alloc[20];
    int nb, np, i, j, pos;

    printf("Enter number of blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for(i = 0; i < nb; i++)
        scanf("%d", &b[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for(i = 0; i < np; i++)
        scanf("%d", &p[i]);

    for(i = 0; i < np; i++)
    {
        pos = -1;

        for(j = 0; j < nb; j++)
        {
            if(b[j] >= p[i])
            {
                if(pos == -1 || b[j] < b[pos])
                    pos = j;
            }
        }

        if(pos != -1)
        {
            alloc[i] = pos + 1;
            b[pos] = b[pos] - p[i];
        }
        else
        {
            alloc[i] = -1;
        }
    }

    printf("\nProcess\tSize\tBlock\n");

    for(i = 0; i < np; i++)
    {
        if(alloc[i] == -1)
            printf("P%d\t%d\tNot Allocated\n", i + 1, p[i]);
        else
            printf("P%d\t%d\t%d\n", i + 1, p[i], alloc[i]);
    }

    return 0;
}
