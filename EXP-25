#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    char data[] = "UNIX System Calls";
    char buffer[100];
    struct stat info;

    fd = open("sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if(fd < 0)
    {
        printf("File opening failed");
        return 1;
    }

    write(fd, data, sizeof(data));

    printf("File created successfully\n");

    int flags = fcntl(fd, F_GETFL);
    printf("File flags: %d\n", flags);

    lseek(fd, 0, SEEK_SET);

    read(fd, buffer, sizeof(data));
    printf("File content: %s\n", buffer);

    stat("sample.txt", &info);
    printf("File size: %lld bytes\n", (long long)info.st_size);

    close(fd);

    DIR *dir = opendir(".");

    if(dir == NULL)
    {
        printf("Directory opening failed");
        return 1;
    }

    struct dirent *entry;

    printf("\nDirectory contents:\n");

    while((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
