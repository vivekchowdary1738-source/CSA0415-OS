
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, a[50], head, i, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Seek sequence: %d ", head);

    for(i = 0; i < n; i++) {
        total += abs(head - a[i]);
        head = a[i];
        printf("%d ", head);
    }

    printf("\nTotal seek time = %d\n", total);

    return 0;
}
