
#include <stdio.h>

int main() {
    int n, index, count, i, b[50];
    int used[100] = {0}, valid = 1;

    printf("Enter total disk blocks: ");
    scanf("%d", &n);

    printf("Enter index block: ");
    scanf("%d", &index);

    printf("Enter number of file blocks: ");
    scanf("%d", &count);

    if(index < 0 || index >= n || count <= 0 || count >= n) {
        printf("Invalid allocation\n");
        return 0;
    }

    used[index] = 1;

    printf("Enter file blocks: ");
    for(i = 0; i < count; i++) {
        scanf("%d", &b[i]);

        if(b[i] < 0 || b[i] >= n || used[b[i]]) {
            valid = 0;
        } else {
            used[b[i]] = 1;
        }
    }

    if(valid) {
        printf("File allocated successfully\n");
        printf("Index block: %d\n", index);
        printf("Index table:\n");

        for(i = 0; i < count; i++)
            printf("%d -> %d\n", i + 1, b[i]);
    } else {
        printf("Invalid or already allocated blocks\n");
    }

    return 0;
}
