
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>

int main()
{
    int shmid;
    char *str;

    shmid = shmget(1234, 1024, 0666 | IPC_CREAT);

    if(shmid == -1)
    {
        printf("Shared memory creation failed\n");
        return 1;
    }

    str = (char *)shmat(shmid, NULL, 0);

    if(str == (char *)-1)
    {
        printf("Shared memory attachment failed\n");
        return 1;
    }

    printf("Enter a message: ");
    fgets(str, 1024, stdin);

    printf("Data written to shared memory: %s", str);
    printf("Data read from shared memory: %s", str);

    shmdt(str);
    shmctl(shmid, IPC_RMID, NULL);

    return 0;
}
