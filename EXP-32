
#include <stdio.h>

int main() {
    int n, f, p[50], a[10], time[10];
    int i, j, pos, faults = 0, found, t = 0;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &p[i]);

    printf("Enter number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++) {
        a[i] = -1;
        time[i] = 0;
    }

    for(i = 0; i < n; i++) {
        found = 0;
        t++;

        for(j = 0; j < f; j++) {
            if(a[j] == p[i]) {
                found = 1;
                time[j] = t;
                break;
            }
        }

        if(!found) {
            pos = 0;

            for(j = 0; j < f; j++) {
                if(a[j] == -1) {
                    pos = j;
                    break;
                }
                if(time[j] < time[pos])
                    pos = j;
            }

            a[pos] = p[i];
            time[pos] = t;
            faults++;
        }

        for(j = 0; j < f; j++)
            printf("%d ", a[j]);

        printf("\n");
    }

    printf("Total Page Faults = %d\n", faults);
    return 0;
}
