#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char filename[100], word[100], line[200];
    int found = 0;

    printf("Enter file name: ");
    scanf("%s", filename);

    printf("Enter word to search: ");
    scanf("%s", word);

    fp = fopen(filename, "r");

    if(fp == NULL)
    {
        printf("File not found");
        return 1;
    }

    while(fgets(line, sizeof(line), fp))
    {
        if(strstr(line, word) != NULL)
        {
            printf("%s", line);
            found = 1;
        }
    }

    if(found == 0)
        printf("Word not found");

    fclose(fp);

    return 0;
}
