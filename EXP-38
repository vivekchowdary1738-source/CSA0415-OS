
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, a[50], i, j, head, size, total = 0;
    int temp, pos = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &size);

    for(i = 0; i < n; i++)
        for(j = i + 1; j < n; j++)
            if(a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    while(pos < n && a[pos] < head)
        pos++;

    printf("Seek sequence: %d ", head);

    for(i = pos; i < n; i++) {
        total += abs(head - a[i]);
        head = a[i];
        printf("%d ", head);
    }

    total += abs(head - (size - 1));
    head = size - 1;
    printf("%d ", head);

    for(i = pos - 1; i >= 0; i--) {
        total += abs(head - a[i]);
        head = a[i];
        printf("%d ", head);
    }

    printf("\nTotal seek time = %d\n", total);

    return 0;
}
