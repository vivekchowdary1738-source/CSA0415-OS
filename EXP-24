#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char data[] = "Welcome to UNIX System Calls";
    char buffer[100];

    fd = open("sample.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);

    if(fd < 0)
    {
        printf("File opening failed");
        return 1;
    }

    write(fd, data, sizeof(data));

    close(fd);

    printf("Data written successfully\n");

    fd = open("sample.txt", O_RDONLY);

    if(fd < 0)
    {
        printf("File opening failed");
        return 1;
    }

    read(fd, buffer, sizeof(data));

    printf("File Content: %s\n", buffer);

    close(fd);

    return 0;
}
