#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd1, fd2, n;
    char buffer[100];

    fd1 = open("source.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd1 == -1)
    {
        printf("Cannot create source file\n");
        return 1;
    }

    write(fd1, "Hello Operating System", 22);
    close(fd1);

    fd1 = open("source.txt", O_RDONLY);
    fd2 = open("destination.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd1 == -1)
    {
        printf("Cannot open source file\n");
        return 1;
    }

    if (fd2 == -1)
    {
        printf("Cannot open destination file\n");
        close(fd1);
        return 1;
    }

    while ((n = read(fd1, buffer, sizeof(buffer))) > 0)
    {
        write(fd2, buffer, n);
    }

    close(fd1);
    close(fd2);

    printf("File copied successfully.\n");

    return 0;
}
