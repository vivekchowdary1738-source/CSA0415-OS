
#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][50], name[50];
    int n = 0, choice, i, found;

    do
    {
        printf("\n1. Create File");
        printf("\n2. Display Files");
        printf("\n3. Delete File");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                if(n == 20)
                {
                    printf("Directory is full\n");
                    break;
                }

                printf("Enter file name: ");
                scanf("%49s", name);

                found = 0;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                        found = 1;
                }

                if(found)
                    printf("File already exists\n");
                else
                {
                    strcpy(files[n], name);
                    n++;
                    printf("File created successfully\n");
                }
                break;

            case 2:
                printf("\nFiles in directory:\n");
                for(i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;

            case 3:
                printf("Enter file name to delete: ");
                scanf("%49s", name);

                found = -1;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = i;
                        break;
                    }
                }

                if(found == -1)
                    printf("File not found\n");
                else
                {
                    for(i = found; i < n - 1; i++)
                        strcpy(files[i], files[i + 1]);

                    n--;
                    printf("File deleted successfully\n");
                }
                break;

            case 4:
                printf("Exiting program\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    } while(choice != 4);

    return 0;
}
